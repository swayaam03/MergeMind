# Environment variables template

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Application
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# LLM Merge Agent Configuration (LiteLLM / OpenRouter)
LLM_PROVIDER=openrouter
LLM_MODEL=cohere/north-mini-code:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
MERGEMIND_RUN_LLM_INTEGRATION_TESTS=false
